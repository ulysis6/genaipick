var articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Person", "name": "Lao Lu" },
  "publisher": { "@type": "Organization", "name": "GenAIPick", "url": "https://genaipick.com" },
