  "dateModified": "2026-08-12",
  "url": "https://genaipick.com/blog/meta-muse-glimmer-30b-open-source/"
});

var breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://genaipick.com/" },
